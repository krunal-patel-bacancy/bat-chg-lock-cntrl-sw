 208          void printDigit(int N)
 209          {
 210   1          // To store the digit
 211   1          // of the number N
 212   1          unsigned int arr[5] = {0};
 213   1          int i = 0;
 214   1          int j, r;
 215   1        
 216   1          // Till N becomes 0
 217   1          while (N != 0) {
 218   2        
 219   2              // Extract the last digit of N
 220   2              r = N % 10;
 221   2        
 222   2              // Put the digit in arr[]
 223   2              arr[i] = r;
 224   2              i++;
 225   2        
 226   2              // Update N to N/10 to extract
 227   2              // next last digit
 228   2              N = N / 10;
 229   2          }
 230   1      
 231   1          for (j = 0; j < 6; j++) {
 232   2             // printf("\n arr = %d ", arr[j]);
 233   2            if (j == 0 )
 234   2            {
 235   3              sprintf((char *)v1,"%1.0d",arr[3]);
 236   3            }
 237   2            if (j == 1 )
 238   2            {
 239   3              sprintf((char *)v2,"%1.0d",arr[2]);
