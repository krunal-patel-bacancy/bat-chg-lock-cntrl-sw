 387          
 388          double adc_moving_avg(double new_data)
 389          {
 390   1          static double DATA[MOV_AVE_ARR_SIZE];
 391   1          static unsigned char old_data_index = 0;
 392   1          static double sum = 0;
 393   1      
 394   1          /* Subtract oldest value from sum and add new value to sum  */
 395   1          sum = sum - DATA[old_data_index] + new_data;
 396   1      
 397   1          /* Overwrite new value in place of oldest value */
 398   1          DATA[old_data_index] = new_data;
 399   1      
 400   1          /* Increment index. But remember, this is a circular buffer. */
 401   1          old_data_index = (old_data_index == (MOV_AVE_ARR_SIZE-1)) ? 0 : (++old_data_index);
 402   1      
 403   1          return(double)(sum / MOV_AVE_ARR_SIZE);
 404   1        
 405   1      }
