 368          void setXY(unsigned char row, unsigned char col) {
 369   1          sendcommand(0xb0 + row); //set page address
 370   1          sendcommand(0x00 + (8 * col & 0x0f)); //set low col address
 371   1          sendcommand(0x10 + ((8 * col >> 4)&0x0f)); //set high col address
 372   1      }
