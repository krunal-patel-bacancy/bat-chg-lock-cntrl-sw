 185          void BQ24735_write(unsigned char address, unsigned int value)
 186          {
 187   1                  I2C_start();
 188   1                  I2C_write(I2C_SLAVE_ADDRESS);
 189   1                  I2C_write(address);
 190   1                  I2C_write(value & 0xFF);       //LSB
 191   1                  I2C_write(value >> ONE_BYTE);  // MSB
 192   1      
 193   1                  I2C_stop();
 194   1      }
 195          
 196          unsigned char BQ24735_read(unsigned char address)
 197          {
 198   1          unsigned char value = 0x00;
 199   1          I2C_start();
 200   1          I2C_write(I2C_SLAVE_ADDRESS);
 201   1          I2C_write(address);
 202   1          I2C_start();
 203   1          I2C_write(I2C_SLAVE_ADDRESS | I2C_R);
 204   1          value = I2C_read(I2C_NACK);
 205   1          I2C_stop();
 206   1          return value;
 207   1      }
