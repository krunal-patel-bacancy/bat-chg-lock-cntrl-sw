 186          /****************************************************************************** 
 187           * Function Name : vUnlock_BothGuns
 188           * Description   : Releases control of both Gun1 and Gun2 solenoids by unlocking them.
 189           * Arguments     : None
 190           * Return Value  : None
 191           ******************************************************************************/
 192          void vUnlock_BothGuns(void)
 193          {
 194   1          GUN1_LOCK_PIN    = 0; // we dont have control guns so set both lock pins to low
 195   1          GUN2_LOCK_PIN    = 0;
 196   1         
 197   1          GUN1_UNLOCK_PIN  = 1;  // Apply pulse to Gun1 & Gun2 unlock pin
 198   1          Timer2_Delay(24000000,1,100,1000); // to unlock the Guns give a pulse duration of 100ms only
 199   1          GUN1_UNLOCK_PIN  = 0;  // Clear pulse
 200   1      
 201   1          Timer2_Delay(24000000,1,2000,1000); //short delay for safe operation
 202   1      
 203   1          GUN2_UNLOCK_PIN  = 1;  
 204   1          Timer2_Delay(24000000,1,100,1000); // to unlock the Guns give a pulse duration of 100ms only
 205   1          GUN2_UNLOCK_PIN  = 0;  
 206   1        
 207   1          Timer2_Delay(24000000,1,1000,1000); //short delay for safe operation
 208   1        
 209   1          bGunPinsConfigured = 1;  //Again whenever AC mains present then we have to reinit pins as Input so set i
             -t here
 210   1      }
