 326          /******************************************************************************
 327           * Function Name: vADC_Init
 328           * Description  : This function initializes the ADC with software trigger mode.
 329           *                ADC is triggered using Timer0 at intervals defined by TIMER_DELAY_US.
 330           *                It configures the selected channel for analog input.
 331           * Arguments    : None
 332           * Return Value : None
 333           ******************************************************************************/
 334          void vADC_Init()
 335          {
 336   1          ADCCON1 &= ~(0x30);               // Clear ADC clock divider bits
 337   1          ADCCON1 |= (0x30);                // Set ADC clock divider
 338   1      
 339   1          P04_INPUT_MODE;                   // adc channel 5 is used for batt sense which is on PO4 pin so it as first inpu
             -t
 340   1      
 341   1          AINDIDS |= (1 << 5);    // Enable analog input for the selected channel
 342   1      
 343   1          ADCCON1 |= (1 << 0);              // Enable the ADC module
 344   1      
 345   1          ADCCON0 &= ~(0x0F);               // Clear previous channel selection
 346   1          ADCCON0 |= (5 & 0x07);  // Select desired ADC channel
 347   1      }
