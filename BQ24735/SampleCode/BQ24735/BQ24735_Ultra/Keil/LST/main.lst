 299          /******************************************************************************
 300           * Function Name: fConvertADCtoInputVoltage
 301           * Description  : Converts 12-bit ADC raw count to actual input voltage (before
 302           *                voltage divider). voltage divider R1 = 147k, R2 = 51k.
 303           * Arguments    : u16AdcCount - Raw ADC value (0 to 4095 for 12-bit ADC)
 304           * Return Value : float - Actual input voltage in volts
 305           ******************************************************************************/
 306          float fConvertADCtoInputVoltage(uint16_t u16AdcCount)
 307          {
 308   1          float fAdcVoltage;     // Voltage at ADC pin (after divider)
 309   1          float fInputVoltage;   // Actual input voltage (before divider)
 310   1       
 311   1          const float  fR1 = 147.0f;
 312   1          const float  fR2 = 51.0f;
 313   1          const float  fDIVIDER_RATIO   = fR2 / (fR1 + fR2);  // R2 / (R1 + R2)
 314   1          const float  fADC_REF_VOLTAGE = 3.3f;        // ADC reference voltage
 315   1          const uint16_t u16ADC_MAX_COUNT = 4095;       // 12-bit ADC maximum count
 316   1      
 317   1          // Step 1: Convert raw ADC count to voltage at the ADC pin
 318   1          fAdcVoltage = ((float)u16AdcCount * fADC_REF_VOLTAGE) / u16ADC_MAX_COUNT;
 319   1      
 320   1          // Step 2: Calculate the original input voltage before the voltage divider
 321   1          fInputVoltage = fAdcVoltage / fDIVIDER_RATIO;
 322   1      
 323   1          return fInputVoltage;
 324   1      }
