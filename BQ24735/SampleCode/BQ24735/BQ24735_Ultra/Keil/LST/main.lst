 135          void main (void) 
 136          {
 137   1        bit bIsAcMainsPrevState = 1;      // Track previous AC mains state; assume AC is present at startup
 138   1        
 139   1        SET_GUN_PINS_AS_OUTPUT();         //set pins initially as input for safe operation
 140   1        MAINS_DETECT_PIN_SET_INPUT();     // Initialize AC mains detection pin
 141   1        
 142   1        vUart_Init();                     // Initialize UART0 for printf debugging
 143   1        vADC_Init();                      // Initialize ADC for battery voltage measurement
 144   1        vTimer0_Init_Dynamic(TIMER_DELAY_US);  // Initialize Timer0 with dynamic delay [currentl 1ms is used]
 145   1        
 146   1        Init_I2C();                            // Initialize I2C communication
 147   1        
 148   1        vI2C_Send_charging_commands();
 149   1      
 150   1        //Initially Sets all pins to LOW
 151   1        GUN1_LOCK_PIN    = 0;     
 152   1        GUN1_UNLOCK_PIN  = 0; 
 153   1        GUN2_LOCK_PIN    = 0;
 154   1        GUN2_UNLOCK_PIN  = 0;
 155   1        
 156   1      /******************************************************************************
 157   1       * Main application loop
 158   1       * - Monitors AC mains status
 159   1       * - Unlocks both guns when AC is lost (pulse once)
 160   1       * - Continuously measures battery voltage
 161   1       ******************************************************************************/
 162   1      while (1)
 163   1      {
 164   2          if (IS_AC_MAINS_PRESENT)
 165   2          {
 166   3              vGunInputAndI2CCmd();
 167   3              bIsAcMainsPrevState = 1;     // AC mains is confirmed present
 168   3          }
 169   2          else
 170   2          {
 171   3              if (bIsAcMainsPrevState == 1)
 172   3              {
 173   4                  Timer2_Delay(24000000,1,1000,1000);    // Wait 1 second to confirm AC loss
 174   4      
 175   4                  if (!IS_AC_MAINS_PRESENT)             // Confirm AC is still not present
 176   4                  {
C51 COMPILER V9.60.7.0   MAIN                                                              08/22/2025 16:50:57 PAGE 4   

 177   5                      vUnlock_BothGuns();               // Apply 100 ms pulse to both unlock pins
 178   5                      bIsAcMainsPrevState = 0;          // Mark AC as gone to prevent retrigger
 179   5                  }
 180   4              }
 181   3          }
 182   2          vMeasureBattery();
 183   2      }
 184   1      }
