 360          /******************************************************************************
 361           * Function Name: vTimer0_Init_Dynamic
 362           * Description  : This function initializes Timer0 in 13-bit mode to generate
 363           *                a dynamic delay based on the input time in microseconds.
 364           *                It calculates the reload value and configures Timer0 to
 365           *                overflow after the specified delay.
 366           * Arguments    : u16Delay_us - Desired delay in microseconds (µs)
 367           * Return Value : None
 368           ******************************************************************************/
 369          void vTimer0_Init_Dynamic(uint16_t u16Delay_us)
 370          {
 371   1          uint16_t u16Reload;
 372   1          uint16_t u16Ticks = u16Delay_us * TIMER0_TICKS_PER_US;
 373   1      
 374   1          // Limit the maximum tick count to 13-bit timer max value (8192)
 375   1          if (u16Ticks >= 8192)
 376   1              u16Ticks = 8191;
 377   1      
 378   1          // Calculate the reload value to count from (8192 - desired ticks)
 379   1          u16Reload = 8192 - u16Ticks;
 380   1      
 381   1          // Extract high and low parts of the 13-bit reload value
 382   1          u8TH0_reload = (u16Reload >> 5) & 0xFF;  // Upper 8 bits
 383   1          u8TL0_reload = u16Reload & 0x1F;         // Lower 5 bits [ so total 13bits ]
 384   1      
 385   1          // Load values into Timer0 registers
 386   1          TH0 = u8TH0_reload;
 387   1          TL0 = u8TL0_reload;
 388   1      
 389   1          // Configure and start Timer0
 390   1          ENABLE_TIMER1_MODE0;        // Set Timer0 to 13-bit mode (Mode 0)
 391   1          TIMER0_FSYS_DIV12;          // Set clock source as system clock divided by 12
 392   1          ENABLE_TIMER0_INTERRUPT;    // Enable Timer0 interrupt (optional)
 393   1          ENABLE_GLOBAL_INTERRUPT;    // Enable global interrupts
 394   1          set_TCON_TR0;               // Start Timer0
 395   1      }
 396          
 397          /******************************************************************************
 398           * Function Name: vUart_Init
 399           * Description  : This function initializes UART0 for debugging purposes using
 400           *                printf. It sets the system clock, configures the UART pin,
 401           *                and sets the baud rate.
 402           * Arguments    : None
 403           * Return Value : None
 404           ******************************************************************************/
 405          void vUart_Init(void)
 406          {
 407   1          /* UART0 setting for printf function */
 408   1          MODIFY_HIRC(HIRC_24);                     // Set internal RC to 24 MHz
 409   1          P06_QUASI_MODE;                           // Set P0.6 as quasi mode for TX
 410   1          UART_Open(24000000, UART0_Timer3, 115200); // Initialize UART0 using Timer3, 115200 baud
 411   1          ENABLE_UART0_PRINTF;                      // Enable printf support via UART0
 412   1      }


